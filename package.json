{
  "name": "agent-live",
  "version": "0.3.4",
  "description": "A read-only live dashboard for what your AI agent is actually doing — built from its own JSONL ledgers.",
  "type": "module",
  "bin": {
    "agent-live": "./server.mjs",
    "agent-autonomy": "./packages/autonomy/src/daemon.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "demo": "node server.mjs --demo",
    "fixtures": "node fixtures/generate.mjs",
    "test:autonomy": "node --test packages/autonomy/test/scheduler.test.mjs",
    "autonomy": "node packages/autonomy/src/daemon.mjs",
    "autonomy:test": "node --test packages/autonomy/test/scheduler.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "observability",
    "agent",
    "activity"
  ],
  "license": "MIT",
  "files": [
    "dsh",
    "public",
    "fixtures",
    "server.mjs",
    "config.example.json",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "packages",
    "lib",
    "adapters"
  ],
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./server": "./server.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mumu032/DSH-agent-live-vision.git"
  },
  "homepage": "https://github.com/mumu032/DSH-agent-live-vision#readme",
  "bugs": {
    "url": "https://github.com/mumu032/DSH-agent-live-vision/issues"
  }
}
